# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/survivors
# Clerk Dashboard → API keys → Secret key.
CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk's JWT public key (PEM), to verify tokens without fetching Clerk's keys.
# CLERK_JWT_KEY=
# Optional: extra origins allowed to call the API, comma separated (my-pokemon-world.netlify.app and localhost always are).
# CORS_ORIGINS=https://deploy-preview-1--my-pokemon-world.netlify.app
PORT=3000
# Optional: verified emails (comma separated) whose owners get the admin gift desk. Empty: nobody is admin.
# ADMIN_EMAILS=admin@example.com
